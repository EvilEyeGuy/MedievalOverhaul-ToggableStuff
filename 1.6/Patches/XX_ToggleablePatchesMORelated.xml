<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="MedievalOverhaulToggleableStuff.PatchOperation_ToggleSettings">
		<settings>
			<li>MOTS_FlickFireplace</li>
		</settings>
		<active Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[
					defName="DankPyon_Pyre" or 
					defName="DankPyon_PyreRound" or 
					defName="DankPyon_RusticHearth" or 
					defName="DankPyon_WoodBurningStove"]/comps</xpath>
					<value>
						<li Class="CompProperties_Flickable"/>
					</value>
				</li>
			</operations>
		</active>
	</Operation>

	<Operation Class="MedievalOverhaulToggleableStuff.PatchOperation_ToggleSettings">
		<settings>
			<li>MOTS_DeconstructScrap</li>
		</settings>
		<active Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[@Name="DankPyon_SmallRuin"]/building/deconstructible</xpath>
					<value>
						<deconstructible>true</deconstructible>
					</value>
				</li>
				
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DankPyon_RuinedBatteringRam"]</xpath>
					<value>
					<building><deconstructible>true</deconstructible></building>					
					</value>
				</li>
				
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DankPyon_RuinedSiegeTower"]</xpath>
					<value>
					<building><deconstructible>true</deconstructible></building>	
					</value>
				</li>
				
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DankPyon_AncientRuinedBarrel"]</xpath>
					<value>
					<building><deconstructible>true</deconstructible></building>	
					</value>
				</li>
			</operations>
		</active>
	</Operation>

